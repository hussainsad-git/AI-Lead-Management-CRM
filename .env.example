# ---------------------------------------------------------------
# LeadFlow CRM — environment template. Copy to .env (never commit .env).
# ---------------------------------------------------------------
APP_NAME="LeadFlow CRM"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://crm.example.com
ASSET_VERSION=1             # bump after deploying changed CSS/JS to bust browser caches

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file

# Passwords: Argon2id (tune to your server; ~0.3–0.5s per hash is a good target)
HASH_DRIVER=argon2id
ARGON_MEMORY=65536
ARGON_TIME=4
ARGON_THREADS=1

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=leadflow
DB_USERNAME=leadflow
DB_PASSWORD=
# For local development only you may use: DB_CONNECTION=sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true  # requires HTTPS; set false only for local http
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database
QUEUE_CONNECTION=database   # imports run on the queue; a worker MUST be running (see README)
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

MAIL_MAILER=log             # set to smtp/ses/postmark for email notifications (Phase 3)
MAIL_FROM_ADDRESS="crm@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Imports
IMPORT_MAX_ROWS=50000
IMPORT_MAX_UPLOAD_KB=20480
FOLLOWUP_MISSED_AFTER_HOURS=24

# --- AI & WhatsApp ---
# API keys and WhatsApp tokens are entered per business in Integrations and stored encrypted with APP_KEY.
# These only override endpoints/defaults (useful for proxies or Azure-compatible gateways).
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_DEFAULT_MODEL=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_DEFAULT_MODEL=deepseek-v4-flash
# WHATSAPP_GRAPH_URL=https://graph.facebook.com
# WHATSAPP_API_VERSION=v24.0
AI_TIMEOUT_SECONDS=30
KB_MAX_FILE_KB=10240
